# Byte-compiled / optimized / CPython generated files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.venv/
env/
venv/
ENV/

# Testing and type checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Project AegisMar: Analytical & Raw AIS Datasets (Preserve data directory structure, never commit raw data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Committed small sample test fixtures are preserved
!data/samples/
!data/samples/**

# Experiments & Benchmark Artifacts (Never commit large benchmark runs)
experiments/outputs/*
!experiments/outputs/.gitkeep

# Environment variables & local secrets
.env
.env.*
!.env.example

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

